# PORT: Port du serveur (défaut: 3000)
PORT=3000
NODE_ENV=production

# GEMINI_API_KEY: Clé API Google Gemini pour l'OCR, la classification et le résumé automatique
GEMINI_API_KEY=""

# APP_URL: URL publique de l'application (ex: https://nexora.votredomaine.com)
APP_URL="http://localhost:3000"

# Configuration SMTP (ex: Gmail, Brevo, Sendgrid, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="NEXORA"

# Configuration FedaPay (Paiement Carte Bancaire Visa/Mastercard & Mobile Money MTN/Moov/Wave/Celtiis)
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_SANDBOX=true

# Groq / Qwen / OpenAI compatible API key
GROQ_API_KEY=""
OPENAI_API_KEY=""
